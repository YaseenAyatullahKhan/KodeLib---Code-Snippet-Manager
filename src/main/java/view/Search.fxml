<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #cde2ff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SearchController">
   <children>
      <VBox layoutX="10.0" layoutY="10.0" prefHeight="500" prefWidth="700" spacing="15">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10">
               <children>
                  <TextField fx:id="searchBar" prefHeight="26.0" prefWidth="122.0" promptText="🔎 Search name or tags... " style="-fx-background-radius: 20px;" HBox.hgrow="ALWAYS" />
                  <CheckBox fx:id="caseToggle" mnemonicParsing="false" text="Case Sensitive" textFill="BLACK" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
               <children>
                  <Label text="Filters:" textFill="BLACK" style="-fx-font-weight: bold;" />
                  <ComboBox fx:id="langFilter" prefHeight="27.0" prefWidth="127.0" promptText="&lt;/&gt; Language" style="-fx-background-color: #a7cbff; -fx-background-radius: 20px; -fx-border-color: #ffffff; -fx-border-radius: 20px;" />
                  <ComboBox fx:id="tagFilter" prefHeight="27.0" prefWidth="127.0" promptText="🏷 Tag" style="-fx-background-color: #a7cbff; -fx-background-radius: 20px; -fx-border-color: #ffffff; -fx-border-radius: 20px;" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
               <children>
                  <Label text="Created:" textFill="BLACK" />
                  <DatePicker fx:id="createdStartDate" prefWidth="140" promptText="From" style="-fx-background-color: ; -fx-background-radius: 10px;" />
                  <DatePicker fx:id="createdEndDate" prefWidth="140" promptText="To" style="-fx-background-color: #a7cbff; -fx-background-radius: 10px;" />
                  <Label text="Modified:" textFill="BLACK" />
                  <DatePicker fx:id="modifiedStartDate" prefWidth="140" promptText="From" style="-fx-background-color: #a7cbff; -fx-background-radius: 10px;" />
                  <DatePicker fx:id="modifiedEndDate" prefWidth="140" promptText="To" style="-fx-background-color: #a7cbff; -fx-background-radius: 10px;" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
               <children>
                  <Label text="Sort:" textFill="BLACK" style="-fx-font-weight: bold;" />
                  <ComboBox fx:id="sortBox" prefHeight="26.0" prefWidth="180.0" promptText="⇅ Sort By" style="-fx-background-color: #a7cbff; -fx-background-radius: 20px; -fx-border-color: #ffffff; -fx-border-radius: 20px;" />
               </children>
            </HBox>
            <TableView fx:id="tableView" prefHeight="294.0" prefWidth="510.0" style="-fx-background-radius: 10px; -fx-background-color: #f2f2f2;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colName" prefWidth="150" text="Name" />
                  <TableColumn fx:id="colLang" prefWidth="100" text="Language" />
                  <TableColumn fx:id="colTags" prefWidth="150" text="Tags" />
                  <TableColumn fx:id="colCreated" prefWidth="120" text="Date Created" />
                  <TableColumn fx:id="colModified" prefWidth="120" text="Date Modified" />
                  <TableColumn fx:id="colActions" prefWidth="80" text="Actions" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10">
               <children>
                  <Button onAction="#switchToCollections" prefHeight="30.0" prefWidth="140.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 10px;" text="Manage Collections" />
                  <Button onAction="#switchToHome" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #d7c900; -fx-text-fill: white; -fx-background-radius: 10px;" text="Back to Home" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>