<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane fx:id="scenePane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SnippetEditorController">
   <top>
      <MenuBar prefHeight="31.0" prefWidth="600.0" BorderPane.alignment="TOP_LEFT">
         <menus>
            <Menu mnemonicParsing="false" text="File">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#handleNew" text="New">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="N" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                     </accelerator>
                  </MenuItem>
                  <MenuItem mnemonicParsing="false" onAction="#handleSave" text="Save">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="S" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                     </accelerator>
                  </MenuItem>
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Edit">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#handleDelete" text="Delete">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="DELETE" control="UP" meta="UP" shift="UP" shortcut="ANY" />
                     </accelerator>
                  </MenuItem>
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="View">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#checkVersions" text="Compare Versions" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>
   <left>
      <TextArea fx:id="codeField" prefHeight="374.0" prefWidth="426.0" promptText="Enter Snippet Here" style="-fx-background-color: #9a9ea8;" BorderPane.alignment="CENTER" />
   </left>
   <right>
      <AnchorPane prefHeight="500.0" prefWidth="174.0" style="-fx-background-color: #cde2ff;" BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="titleField" layoutX="14.0" layoutY="7.0" promptText="Name" />
            <ComboBox fx:id="choiceBox1" layoutX="14.0" layoutY="59.0" prefWidth="150.0" promptText="Language" />
            <ComboBox fx:id="choiceBox2" layoutX="14.0" layoutY="96.0" prefWidth="150.0" promptText="Tag" />
            <TextArea fx:id="descriptionField" layoutX="14.0" layoutY="134.0" prefHeight="75.0" prefWidth="150.0" promptText="Description" />
            <Label layoutX="14.0" layoutY="213.0" style="-fx-font-weight: bold; -fx-font-size: 11;" text="Backlinks:" textFill="#ffbf00" />
            <ListView fx:id="backlinksListView" layoutX="14.0" layoutY="231.0" prefHeight="65.0" prefWidth="150.0" style="-fx-background-radius: 5px;" />
            <Separator layoutX="-6.0" layoutY="-1.0" orientation="VERTICAL" prefHeight="370.0" prefWidth="3.0" style="-fx-background-color: #ff902f;" />
            <Button fx:id="BackToMainPage" layoutX="31.0" layoutY="330.0" mnemonicParsing="false" onAction="#switchToHome" style="-fx-background-color: #324e99; -fx-background-radius: 20px; -fx-border-color: #ffffff; -fx-border-radius: 20px;" text="Back to Main Page" textFill="#faf6f6" />
         </children>
      </AnchorPane>
   </right>
</BorderPane>